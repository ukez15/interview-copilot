<Project>
  <!-- Central package management. Exact versions only; review each upgrade individually. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analyzers / build">
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup Label="Api / ServiceDefaults">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire (dev only)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xunit v3 runs on Microsoft.Testing.Platform (see global.json "test.runner"). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- 7.x is Apache-2.0; 8.x requires a commercial licence. Stay on 7.x. -->
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
</Project>
