{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Urls": "http://127.0.0.1:5480",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "app://interview-copilot" ]
  },
  "Storage": {
    "DataDirectory": ""
  },
  "Transcription": {
    "Provider": "whisper",
    "Vad": {
      "SilenceThresholdDbfs": -40,
      "PauseMs": 600,
      "MaxSegmentMs": 15000,
      "MinSpeechMs": 300,
      "QueueFrames": 200
    },
    "Providers": {
      "Whisper": {
        "Model": "ggml-small.en.bin",
        "Language": "en"
      },
      "Deepgram": {
        "Enabled": false,
        "BaseUrl": "https://api.deepgram.com/",
        "Model": "nova-3"
      }
    }
  },
  "Llm": {
    "Provider": "ollama",
    "Model": "llama3.2:3b",
    "Temperature": 0.4,
    "Ollama": {
      "BaseUrl": "http://127.0.0.1:11434/"
    }
  }
}
