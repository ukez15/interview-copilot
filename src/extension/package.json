{
  "name": "@interview-copilot/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "InterviewCopilot companion extension for Chrome, Edge and Firefox (Manifest V3)",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir web-ext-artifacts --overwrite-dest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
